        { "id": "func_machine", "name": "设备管理", "permission": "machine:manage", "route": "/machine", "component": "DomainModuleView", "module": "核心模块", "fixed": true, "description": "管理设备台账、运行/停机/维修状态、点检维护记录及设备使用环境，支撑生产报工与设备状态联动。" },
