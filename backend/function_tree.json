        { "id": "func_method", "name": "工艺管理", "permission": "method:manage", "route": "/method", "component": "DomainModuleView", "module": "核心模块", "fixed": true, "description": "维护工艺流程、作业指导、站点顺序与不良代码规则，支撑过站报工、返修流转和工艺追溯。" },
